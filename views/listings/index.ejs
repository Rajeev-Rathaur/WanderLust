<%- layout("layouts/boilerplate") -%>

<body>
    <h3 class="mainheading"><b>All Listings</b></h3>
    <!-- <form action="/listings/new" method="GET">
        <button>Create new Listing</button>
    </form> -->

    <div class="row row-cols-lg-3 row-cols-md-2  row-cols-1 g-4">
<% for(let list of allListings) {%>
    <a href="/listings/<%=list._id%>" class="listing-link">
    <div class="card col">
  <img src="<%=list.image.url%>" class="card-img-top" alt="all-listings" style="height: 20rem;">
    <div class="card-img-overlay"></div>
  <div class="card-body">
    <b class="card-title"><%= list.title %></b>
    <p class="card-text">
        &#8377 <%=list.price?
         list.price.toLocaleString("en-IN"):
         "N/A" %>/night
    </p>
    <!-- <a href="#" class="btn btn-primary">Go somewhere</a> -->
  </div>
</div>
</a>

<% } %>
    </div>

    <!-- <ul>
        <% for(let list of allListings){ %>
            <li><a href="/listings/<%=list._id%>"><%=list.title%></a></li>
            <% } %>
    </ul> -->

</body>
    

