<%- layout("layouts/boilerplate") -%>
<div class="row mt-3">
    <div class="col-8 offset-2">

    <h2><b>Listing details</b></h2>
    <div class="card" width="10px">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image">
  <div class="card-body show-card-body">
    <h5 class="card-title show-page-title"><b><%=listing.title%></b></h5>
    <p class="card-text show-page-description"><%=listing.description%> <br><br>
        &#8377 <%=listing.price?
         listing.price.toLocaleString("en-IN"):
         "N/A" %>/night <br> 
       <%= listing.location%> <br>
        <%= listing.country %>
    </p>
  </div>
    </div>
    <br>

    <div class="d-flex gap-2 edit-del-btn ">
    <button class="btn btn-dark edit-page-button">
    <a href="/listings/<%=listing._id%>/edit" class="edit-in-show">Edit</a>             
    </button>
  
    <form action="/listings/<%=listing._id%>?_method=delete" method="post">
        <button class=" btn btn-dark  del-btn">Delete</button>
    </form>
    <button class="btn btn-dark edit-page-button">
        <a href="/listings" class="edit-in-show">Back</a>
    </button>
    </div>
   <!-- <button type="button" class="btn btn-dark edit-page-button">Edit</button>
   <button type="button" class="btn btn-dark  del-btn">Delete</button>
   <button type="button" class="btn btn-dark edit-page-button">Back</button> -->
   </div>
    


    </div>
</div>
    

