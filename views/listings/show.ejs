<%- layout("layouts/boilerplate") -%>
<script>
   const map_token= "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>
<div class="row mt-3 roww">
    <div class="col-8 offset-2">

    <h2><b><%=listing.title%></b></h2>
    <div class="card listing-cards" width="10px">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_image">
  <div class="card-body show-card-body">
    <p><i><b>Owned by:-<%= listing.owner.username %></b></i></p>
        <br>
    <p class="card-text show-page-description"><%=listing.description%> <br><br>
        &#8377 <%=listing.price?
         listing.price.toLocaleString("en-IN"):
         "N/A" %>/night <br> 
       <%= listing.location%> <br>
        <%= listing.country %>
    </p>
  </div>
    </div>
    <br>
     
<% if(currUser && listing.owner._id.equals(currUser._id)) { %>
   
    <div class="d-flex gap-2 edit-del-btn ">
    <button class="btn btn-dark edit-page-button">
    <a href="/listings/<%=listing._id%>/edit" class="edit-in-show">Edit</a>             
    </button>
  
    <form action="/listings/<%=listing._id%>?_method=delete" method="post">
        <button class=" btn btn-dark  del-btn">Delete</button>
    </form>
    <button class="btn btn-dark edit-page-button">
        <a href="/listings" class="edit-in-show">Back</a>
    </button>
    </div>

<% } %>

   
   <!-- <button type="button" class="btn btn-dark edit-page-button">Edit</button>
   <button type="button" class="btn btn-dark  del-btn">Delete</button>
   <button type="button" class="btn btn-dark edit-page-button">Back</button> -->
   </div>
    
    </div>
  

    <% if(currUser)  {%>
    <div class="col-8 offset-2 mb-3" >
   <hr>
        <h4><b>Leave a Review</b></h4>
        <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
            <!-- <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" 
                class="form-range" min="0" max="5"
                id="rating" 
                name="review[rating]">
            </div> -->
   <label for="rating" class="form-label">Rating</label>
  <div class="mt-3 mb-3" >
  <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" 
                id="comment" 
                cols="30" 
                rows="5"
                class="form-control"
                required
                ></textarea>
            <div class="invalid-feedback">Please add some comment for review!</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
    </div>
    <% } %>


    <% if(listing.reviews.length>0) { %>
    <div class="col-8 offset-2 mb-3">
        <hr>
        <h4><b>ALL Reviews</b></h4>
        <div class="row review-row">
    <% for(list of listing.reviews){ %>
        <div  class="card mb-3 ms-3 col-5">
            <div class="card-body">
                <h5 class="card-title"><b>@<%=list.author.username %></b></h5>
                 <p class="starability-result card-text" data-rating="<%=list.rating%>"></p>
        <p class="card-text"><%=list.comment%></p>
    </div>

    <form action="/listings/<%= listing._id %>/reviews/<%= list._id %>?_method=DELETE" class="mb-3" method="post">
        <button class="btn btn-sm btn-dark ms-3">Delete</button>
    </form>

    </div>
    <%  } %>

    
</div> 
</div>

<% } %>

<div class="col-8 offset-2">
    <h3>Where you'll be</h3>
    <div id="map"></div>
</div>

<script src="/js/map.js"></script>

    

