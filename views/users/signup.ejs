<% layout("/layouts/boilerplate") -%>
<h1 class="col-6 offset-3">Signup on Wanderlust</h1>
 <div class="row">
       <div class="col-6 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>

      <div class="mb-3">
        <label for="username" class="form-title"><b>Username</b></label>
        <input type="text" name="username" id="username" class="form-control" required>
        <div class="valid-feedback">looks good!</div>
      </div>

      
       

      <div class="mb-3">
        <label for="email" class="form-title"><b>E mail</b></label>
        <input type="email" name="email" id="email" class="form-control" required>
      </div>

      
      <div class="mb-3">
        <label for="Password" class="form-title"><B>Password</B></label>
        <input type="Password" name="Password" id="Password" class="form-control" required>
      </div>

      <button class="btn btn-success">Signup</button>
      <a href="/login" style="color:black">Already have an account? login</a>

        </form>

       </div>
</div>